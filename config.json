{
  "port": 8787,
  "host": "0.0.0.0",
  "dataDir": "data",
  "osmDb": "data/osm/osm.sqlite",
  "osmSource": "data/osm/Beijing.osm.gz",
  "defaultCenter": {
    "lat": 39.9042,
    "lng": 116.4074,
    "zoom": 16
  },
  "maxPlayers": 64,
  "sessionDays": 30,
  "allowAnyRollback": false,
  "allowGuests": false,
  "historyLimit": 200,
  "limits": {
    "opsPer10s": 120,
    "chatPer10s": 6,
    "maxChatLength": 200,
    "viewportLimit": 15000,
    "wayCandidates": 12,
    "nodeCandidates": 8,
    "relationLimit": 10000,
    "groupMaxDepth": 8,
    "groupMaxSteps": 500,
    "groupIdleMs": 5000,
    "groupTtlMs": 120000
  },
  "regions": {
    "_note": "分区流式（deploy/REGIONS.md）第一阶段：只读查询走分片。**默认 off** —— 关闭时服务端连注册表都不读、一个分片库都不打开，行为与改动前逐字节相同（既有测试套件全部照旧）。打开：把 mode 改成 on，或者起实例时加 --regions（显式给了 --osm 时会被强制关，除非同时显式 --regions）。写路径不受影响：新增元素与所有写操作仍然只走 config.osmDb 那一个库。",
    "mode": "off",
    "registry": "data/regions/registry.json",
    "fanoutMax": 2,
    "fallbackBelowZoom": 11,
    "mergedBytesLimit": 4194304,
    "allowOverlap": true,
    "conflictListMax": 20,
    "readOnlyShards": true,
    "budgetTrowel": true,
    "logQueries": false,
    "_noteLazy": "P4 惰性建图/启动（REGIONS.md §7）：**只在 mode:'on' 时生效**，mode:'off' 时这一整块代码路径都不会被执行（连字段都不读），所以关着时的行为与本次改动前逐字节相同。打开 mode 后默认 lazy:true ⇒ 只对【激活区域】建图（铁路网/道路网/人口网格/线路路径），未激活的区域不建图、不常驻；lazy:false 是 P4 的一行回滚（等价于启动时按旧的 assetShards 全建）。",
    "lazy": true,
    "lazyIdleMs": 600000,
    "lazySweepMs": 30000,
    "lazyAlwaysActive": [],
    "corridorGraph": true,
    "corridorPadMeters": 5000,
    "corridorTtlMs": 300000,
    "corridorMax": 4,
    "pointGraphRadiusM": 20000,
    "lazyLog": true
  },
  "transit": {
    "startingCash": 200000000,
    "stationCost": 30000000,
    "costPerMeter": {
      "surface": 20000,
      "elevated": 60000,
      "tunnel": 120000
    },
    "vehicleBaseCost": 20000000,
    "vehiclePerCarCost": 5000000,
    "maintenancePerCarPerDay": 20000,
    "fareBase": 3,
    "farePerKm": 0.5,
    "tripRatePerDay": 0.22,
    "serviceHours": 18,
    "dwellSeconds": 30,
    "economy": false,
    "minGapMeters": 45
  }
}
